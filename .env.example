# MySQL 8 connection (use a managed MySQL provider reachable from Vercel)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=your-database-name
DB_SSL=true
DB_CONNECTION_LIMIT=5

# Generate random secrets locally; do not commit real values.
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_SETUP_TOKEN=replace-with-random-token-at-least-24-characters
